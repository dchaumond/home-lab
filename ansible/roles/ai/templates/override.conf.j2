[Service]
Environment="OLLAMA_HOST=0.0.0.0"
Environment="HSA_OVERRIDE_GFX_VERSION=11.0.3"
{% if ollama_gpu_layers | int >= 0 %}
Environment="OLLAMA_NUM_GPU_LAYERS={{ ollama_gpu_layers }}"
{% endif %}
Environment="OLLAMA_NUM_PARALLEL=1"
Environment="OLLAMA_KEEP_ALIVE={{ secrets.ai_node.ollama_keep_alive }}"
Environment="OLLAMA_FLASH_ATTENTION=1"
Environment="OLLAMA_NUM_THREADS=8"
Environment="OLLAMA_GPU_OVERHEAD=1024"
Environment="HSA_ENABLE_SDMA=1"
