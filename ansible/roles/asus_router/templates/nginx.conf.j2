# Configuration nginx principale (gérée par Ansible)
# Fichier : /opt/etc/nginx/nginx.conf

#load_module "lib/nginx/ngx_stream_module.so";

user nobody nobody ;
worker_processes  1;

error_log  /opt/var/log/nginx/error.log;

events {
    worker_connections  1024;
}

#stream {
#  server {
#      listen 1883;
#      proxy_pass {{ router.nginx_proxy_mqtt | default('192.168.1.3:1883') }};
#  }
#}

http {
    include       mime.types;
    default_type  application/octet-stream;

    server_names_hash_bucket_size  64;

    sendfile        on;
    #tcp_nopush     on;

    #keepalive_timeout  0;
    keepalive_timeout  65;

    #gzip  on;

    access_log  /opt/var/log/nginx/access.log;

    # HTTPS reverse proxies
    server {
        listen       {{ router.nginx_port }} ssl;
        server_name  {{ router.nginx_server_name }};
        #ssl                  on;
        ssl_certificate      {{ router.nginx_ssl_cert }};
        ssl_certificate_key  {{ router.nginx_ssl_key }};
        ssl_session_timeout  5m;
        ssl_protocols  TLSv1 TLSv1.1 TLSv1.2;
        ssl_ciphers  HIGH:!aNULL:!MD5;
        ssl_prefer_server_ciphers   on;

        #location /domo/ {
        #       proxy_pass http://{{ router.nginx_proxy_domo | default('192.168.1.41:8080') }};
        #       proxy_redirect       off;
        #        proxy_set_header     Host            $host:$server_port;
        #        proxy_set_header     X-Real-IP       $remote_addr;
        #        #proxy_set_header        X-Forwarded-Proto $scheme;
        #        #add_header              Front-End-Https        on;
        #}

        location /api/ {
{% set proxy_url = router.nginx_proxy_api['url_' ~ router.nginx_proxy_api.active | default('old')] %}
{% if router.nginx_proxy_api.active is defined and router.nginx_proxy_api.active == "new" %}
            set $auth_token $http_authorization;
            if ($http_authorization = "Bearer {{ router.nginx_proxy_api.token_old }}") {
                set $auth_token "Bearer {{ router.nginx_proxy_api.token_new }}";
            }
            proxy_set_header Authorization $auth_token;
{% endif %}

            proxy_pass {{ proxy_url }};
            proxy_redirect off;
            proxy_set_header Host $host:$server_port;
            proxy_set_header X-Real-IP $remote_addr;
        }
    }
}